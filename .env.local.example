# Copy this file to .env.local before running the app.

# --- NextAuth.js ---
# Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# --- MySQL connection ---
# These defaults match MAMP's default MySQL settings (check MAMP's start
# page for yours). A standalone MySQL install usually uses port 3306 instead.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=8889
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=nextjs_expense_tracker

# Set to true for cloud MySQL that requires TLS (e.g. TiDB Cloud when deploying).
MYSQL_SSL=false
